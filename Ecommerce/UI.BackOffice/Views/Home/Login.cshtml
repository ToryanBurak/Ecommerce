@model Domain.Backoffice.UserLogin.LoginViewModel
@{
    Layout = null; // Basit bir tasarım için Layout kullanmıyoruz
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Backoffice Giriş</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container d-flex justify-content-center align-items-center vh-100">
        <div class="card p-4 shadow-lg" style="width: 100%; max-width: 400px;">
            <h3 class="text-center mb-4">Backoffice Giriş</h3>
            <form method="post" action="/Home/Login">
                <div class="mb-3">
                    <label for="email" class="form-label">E-Mail</label>
                    <input type="text" name="Email" class="form-control" asp-for="Email" required id="reg-fn">
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Şifre</label>
                    <input type="password" name="Password" class="form-control" asp-for="Password" required id="reg-fn">
                </div>
                <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
            </form>
        </div>
    </div>
</body>
</html>

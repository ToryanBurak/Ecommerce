@model List<Domain.Backoffice.CategoryDO>

<div class="container mt-5">
    <h2 class="text-center">Kategori Listesi</h2>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>İsim</th>
                <th>Resim</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.Name</td>
                    <td><img src="@category.ImageUrl.Url" alt="@category.Name" class="img-fluid" style="width: 150px; height: 150px;"/></td>
                    <td>
                        <a href="@Url.Action("EditCategory", "Home", new { id = category.Id })" class="btn btn-warning btn-sm">Düzenle</a>
                        <a href="@Url.Action("DeleteCategory", "Home", new { id = category.Id })" class="btn btn-danger btn-sm">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

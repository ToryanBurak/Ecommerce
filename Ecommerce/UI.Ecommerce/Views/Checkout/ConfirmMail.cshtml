@{
    ViewData["Title"] = "Doğrulama Kodu";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" media="screen" href="~/css/vendor.min.css">
    <link rel="stylesheet" media="screen" href="~/css/theme.min.css">
</head>
<body>
    <div class="container d-flex justify-content-center align-items-center" style="height: 100vh;">
        <div class="card border-0 box-shadow" style="max-width: 400px; width: 100%;">
            <div class="card-body">
                <h2 class="h4 text-center mb-4">Doğrulama Kodunu Girin</h2>
                <p class="font-size-sm text-muted text-center mb-4">Lütfen e-posta adresinize gönderilen doğrulama kodunu giriniz.</p>
                <form method="post" asp-action="ConfirmMail" asp-controller="Checkout" class="needs-validation">
                    <div class="form-group">
                        <label for="verificationCode">Doğrulama Kodu</label>
                        <input type="text" name="verificationCode" class="form-control" id="verificationCode" placeholder="6 Haneli Kod" required>
                        <div class="invalid-feedback">Doğrulama kodunu giriniz.</div>
                    </div>
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-warning mt-3" role="alert">
                            @ViewBag.Message
                        </div>
                    }
                    <div class="text-center mt-4">
                        <button class="btn btn-primary" type="submit">Doğrula</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="~/js/vendor.min.js"></script>
    <script src="~/js/theme.min.js"></script>
</body>
</html>

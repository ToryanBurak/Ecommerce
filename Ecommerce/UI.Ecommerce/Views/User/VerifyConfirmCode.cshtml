<div class="main-wrapper login-body">
    <div class="login-wrapper">
        <div class="loginbox">
            <div class="login-auth">
                <div class="login-auth-wrap">
                    <h4>Hesabınıza Giriş Yapmak için Mailinize Gelen Doğrulama Kodunu Giriniz</h4>
                    <form method="post" asp-action="VerifyConfirmCode" asp-controller="User" enctype="multipart/form-data">
                        <div class="input-block">
                            <label class="form-label">Doğrulama Kodu <span class="text-danger">*</span></label>
                            <input type="text" name="code" class="form-control" placeholder="Doğrulama Kodunu Giriniz">
                        </div>
                        <button type="submit" class="btn btn-outline-light w-100 btn-size mt-1">Doğrula</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
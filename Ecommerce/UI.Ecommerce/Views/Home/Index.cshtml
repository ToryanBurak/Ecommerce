<!-- Toast: Added to Cart-->
<div class="toast-container toast-bottom-center">
    <div class="toast mb-3" id="cart-toast" data-delay="5000" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header bg-success text-white">
            <i class="czi-check-circle mr-2"></i>
            <h6 class="font-size-sm text-white mb-0 mr-auto">Sepete Eklendi</h6>
            <button class="close text-white ml-2 mb-1" type="button" data-dismiss="toast" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="toast-body">Ürün Zaten Sepetinizde</div>
    </div>
</div>

<script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>

<script>
    // Swiper Initialization
    var swiper = new Swiper('.swiper-container', {
        slidesPerView: 3,           // Görüntülenen öğe sayısı
        spaceBetween: 15,           // Öğeler arasındaki boşluk
        loop: true,                 // Sonsuz döngü
        navigation: {               // Oklar
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev'
        },
        pagination: {               // Sayfa numarası
            el: '.swiper-pagination',
            clickable: true
        },
        breakpoints: {              // Farklı ekran boyutlarına göre responsive
            0: { slidesPerView: 1 },
            500: { slidesPerView: 2 },
            768: { slidesPerView: 3 },
            992: { slidesPerView: 3 }
        }
    });
</script>
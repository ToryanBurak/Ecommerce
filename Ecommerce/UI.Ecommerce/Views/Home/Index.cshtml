<script type="text/javascript" src="~/js/theme.min.js"></script>


<section class="bg-accent bg-position-center-top bg-no-repeat py-5"
         style="background-image: url(img/home/marketplace-hero.jpg);">
    <div class="pb-lg-5 mb-lg-3">
        <div class="container py-lg-5 my-lg-5">
            <div class="row mb-4 mb-sm-5">
                <div class="col-lg-7 col-md-9 text-center text-sm-left">
                    <h1 class="text-white line-height-base">
                        <span class='font-weight-light'>Tüm</span> Türkiye'de <span class='font-weight-light'>mutlu</span> milyonlarca <span class='font-weight-light'>müşteri</span>
                    </h1>
                    <h2 class="h5 text-white font-weight-light">Siz de ailemize katılın!</h2>
                </div>
            </div>
            <div class="row pb-lg-5 mb-4 mb-sm-5">
                <div class="col-lg-6 col-md-8">
                </div>
            </div>
        </div>
    </div>
</section>

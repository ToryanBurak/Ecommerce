@model List<Domain.Backoffice.ProductDO>
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Hoşgeldiniz.</h1>
    <p>Learn about <a href="https://docs.microsoft.com/aspnet/core">Bursimemfur</a>.</p>
    işte kanıtı:
    @foreach (var item in Model)
    {
       <div>@item.ID id li ürün ismi: @item.Name</div>
    }
</div>

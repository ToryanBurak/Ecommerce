<<<<<<< HEAD
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const cartTable = document.getElementById('cartTable');
            const btnClearCart = document.getElementById('btnClearCart');
            const subtotalSpan = document.getElementById('cartSubtotal');
            const shippingSpan = document.getElementById('cartShipping');
            const totalSpan = document.getElementById('cartTotal');

            const shippingCost = 10;

            calculateCartTotals();

            cartTable.querySelectorAll('.btn-decrement').forEach(btn => {
                btn.addEventListener('click', function () {
                    const input = this.closest('.input-group').querySelector('.cart-qty');
                    let val = parseInt(input.value) || 1;
                    if(val > 1) {
                        val--;
                        input.value = val;
                    }
                    updateRowSubtotal(this);
                    calculateCartTotals();
                });
            });

            cartTable.querySelectorAll('.btn-increment').forEach(btn => {
                btn.addEventListener('click', function () {
                    const input = this.closest('.input-group').querySelector('.cart-qty');
                    let val = parseInt(input.value) || 1;
                    val++;
                    input.value = val;
                    updateRowSubtotal(this);
                    calculateCartTotals();
                });
            });

            cartTable.querySelectorAll('.btn-remove').forEach(btn => {
                btn.addEventListener('click', function () {
                    const row = this.closest('tr');
                    row.remove(); 
                    calculateCartTotals();
                });
            });
            btnClearCart.addEventListener('click', function () {
                const rows = cartTable.querySelectorAll('tbody tr');
                rows.forEach(r => r.remove());
                calculateCartTotals();
            });

            function updateRowSubtotal(button) {
                const row = button.closest('tr');
                const priceCell = row.querySelector('[data-price]');
                const qtyInput = row.querySelector('.cart-qty');
                const subtotalCell = row.querySelector('.subtotalCell');

                let price = parseFloat(priceCell.getAttribute('data-price')) || 0;
                let qty = parseInt(qtyInput.value) || 1;
                let subtotal = price * qty;
                subtotalCell.textContent = `₺${subtotal.toFixed(2)}`;
            } 
            function calculateCartTotals() {
                let sum = 0;
                cartTable.querySelectorAll('tbody tr').forEach(row => {
                    const subtotalCell = row.querySelector('.subtotalCell');
                    if(subtotalCell) {
                        let text = subtotalCell.textContent.replace('₺','').trim();
                        let val = parseFloat(text) || 0;
                        sum += val;
                    }
                });
                subtotalSpan.textContent = `₺${sum.toFixed(2)}`;

                let total = sum + shippingCost;
                totalSpan.textContent = `₺${total.toFixed(2)}`;
            }
        });
    </script>
}
